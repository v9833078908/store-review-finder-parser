ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Public subpath for the unified frontend deployment, for example /search-app in Coolify.
NEXT_PUBLIC_BASE_PATH=

# Frontend runtime wiring.
NEXT_PUBLIC_API_URL=http://localhost:8000
INTERNAL_API_URL=http://localhost:8000
FRONTEND_HOST_PORT=51200
REVIEW_API_HOST_PORT=8000
LEAD_FINDER_HOST_PORT=51100

# Backend CORS allowlist.
CORS_ORIGINS=http://localhost:51100,http://127.0.0.1:51100,http://localhost:51200,http://127.0.0.1:51200

# Langfuse observability (method 2: SDK + observe)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_TRACING_ENABLED=true
LANGFUSE_TRACING_ENVIRONMENT=dev
LANGFUSE_SAMPLE_RATE=1.0
LANGFUSE_ANTHROPIC_OTEL_ENABLED=true
# Optional: perform blocking credentials check once on startup
LANGFUSE_AUTH_CHECK_ON_STARTUP=false

# Optional ngrok tunnel (compose profile: tunnel)
NGROK_AUTHTOKEN=
NGROK_URL=https://unserenaded-nonresponsibly-haydee.ngrok-free.dev
NGROK_INSPECT_PORT=4041
